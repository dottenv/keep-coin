# CloudPub (https://cloudpub.ru) — токен из личного кабинета.
# Нужен для автоматической публикации и выдачи бесплатного домена *.cloudpub.ru.
CLOUDPUB_TOKEN=your-cloudpub-token-here

# Backend: секретный ключ для подписи JWT (обязателен, сгенерируйте случайный).
SECRET_KEY=change-me-to-a-long-random-string

# Telegram Mini App: токен бота (BotFather) — используется и бэкендом для
# проверки init_data, и ботом для работы. Если не задан, эндпоинты Telegram
# возвращают 401.
TELEGRAM_BOT_TOKEN=your-bot-token-from-BotFather
# Username бота без @ — нужен для генерации deep link привязки аккаунта.
TELEGRAM_BOT_USERNAME=keepcoin_bot
# Адрес фронтенда (Mini App), открываемого из бота.
WEBAPP_URL=https://your-domain.example.com

