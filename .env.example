# CloudPub (https://cloudpub.ru) — токен из личного кабинета.
# Нужен для автоматической публикации и выдачи бесплатного домена *.cloudpub.ru.
CLOUDPUB_TOKEN=your-cloudpub-token-here

# Backend: секретный ключ для подписи JWT (обязателен, сгенерируйте случайный).
SECRET_KEY=change-me-to-a-long-random-string
